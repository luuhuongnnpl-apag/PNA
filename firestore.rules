rules_version = '2';
// Quy tắc bảo mật Firestore — PNA – Hệ thống cố vấn học tập (dự án Firebase riêng, 28/11/2026)
// Vai trò: xem | xem-rong | chuyen-muc | bien-muc | quan-tri | các loại tự thêm (pna_settings/roles)  (tài khoản: pna_accounts/{email}; mã dùng chung: pna_ma/{mã})
// Mức truy cập tài liệu (trường access): cong-khai | noi-bo | han-che | mat
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.get('email', ''); }
    function superAdmin() {
      return signedIn() && (
        (email().lower() in ['luuhuong.dhnv@gmail.com', 'luuhuong.nnpl@gmail.com'] && request.auth.token.get('email_verified', false) == true));
    }
    function acctPath() { return /databases/$(database)/documents/pna_accounts/$(email().lower()); }
    function hasAcct() { return signedIn() && email() != '' && exists(acctPath()); }
    function okGrant(g) { return g.get('disabled', false) != true && (g.get('hanTs', null) == null || request.time < g.hanTs); }
    function acctOk() { return hasAcct() && okGrant(get(acctPath()).data); }
    function acct() { return get(acctPath()).data; }
    function userPath() { return /databases/$(database)/documents/pna_users/$(request.auth.uid); }
    function hasCode() { return signedIn() && exists(userPath()) && exists(/databases/$(database)/documents/pna_ma/$(get(userPath()).data.code)); }
    function codeData() { return get(/databases/$(database)/documents/pna_ma/$(get(userPath()).data.code)).data; }

    // ===== Thủ tục sinh viên (28/11/2026) =====
    function me() { return email().lower(); }
    function isCvht() { return acctOk() && acct().role == 'cvht'; }
    function svPath() { return /databases/$(database)/documents/pna_sv/$(me()); }
    function isSv() { return signedIn() && email() != '' && exists(svPath()); }
    function ndPath() { return /databases/$(database)/documents/pna_tt_settings/nguoiduyet; }
    function inNd(k) { return signedIn() && email() != '' && exists(ndPath()) && me() in get(ndPath()).data.get(k, []); }
    function lopCvht(l) { return get(/databases/$(database)/documents/pna_lop/$(l)).data.get('cvht', []); }
    function donReader(d) { return isAdmin() || d.sv.email == me() || me() in d.cvht || inNd('khoa') || inNd('qldt') || bqt(d.lop, 'don'); }
    function donActor(d) {
      return d.status == 'cho-duyet' && (isAdmin()
        || (d.stepRole == 'cvht' && me() in d.cvht)
        || (d.stepRole == 'bcs' && bqt(d.lop, 'don') && d.sv.email != me())
        || (d.stepRole in ['khoa', 'qldt'] && inNd(d.stepRole)));
    }
    function stepOk(n) { return n.status != 'cho-duyet' || (n.step < n.steps.size() && n.stepRole == n.steps[n.step].role); }
    function appended(n, o) { return n.history.size() == o.history.size() + 1; }

    function isAdmin() { return superAdmin() || (acctOk() && acct().role == 'quan-tri'); }
    // Phân quyền tùy chỉnh (13/11/2026): pna_settings/roles { roles: { <loại>: { name, levels, perms{dl,up,edit,move,del,folders,kho,note,ai,rec} } } }
    function rolesPath() { return /databases/$(database)/documents/pna_settings/roles; }
    function roleDef(role) { return exists(rolesPath()) ? get(rolesPath()).data.roles.get(role, null) : null; }
    function levelsOld(role) {
      return role in ['xem', 'sinh-vien'] ? ['cong-khai', 'noi-bo'] : ['cong-khai', 'noi-bo', 'han-che'];
    }
    function levels(role) {
      let d = roleDef(role);
      return role == 'quan-tri' ? ['cong-khai', 'noi-bo', 'han-che', 'mat']
           : (d != null && d.get('levels', null) != null) ? d.levels.removeAll(['mat'])
           : levelsOld(role);
    }
    // Quyền mặc định theo loại (khớp ROLES_DEFAULT trong assets/pna.js); quyền đã lưu ở pna_settings/roles được ưu tiên
    function defPerms(role) {
      return {
        'xem': ['note', 'ai', 'rec'], 'xem-rong': ['note', 'ai', 'rec'], 'chuyen-muc': ['note', 'ai', 'rec', 'dl'],
        'bien-muc': ['dl', 'up', 'edit', 'move', 'del', 'folders', 'kho', 'note', 'ai', 'rec'],
        'cvht': ['note', 'ai', 'rec', 'dl', 'up', 'edit', 'hs', 'pt', 'bbh', 'don'], 'sinh-vien': ['ai'],
        'bcs': ['ai', 'note', 'hs', 'pt', 'bbh', 'don'], 'bch': ['ai', 'note', 'hs', 'pt', 'bbh']
      }.get(role, []);
    }
    function perm(role, p) {
      let d = roleDef(role);
      return role == 'quan-tri' || ((d != null && d.get('perms', {}).keys().hasAny([p])) ? d.perms[p] == true : p in defPerms(role));
    }
    function can(p) { return isAdmin() || (acctOk() && perm(acct().role, p)); }
    function isManager() {
      return isAdmin() || (acctOk() && (perm(acct().role, 'up') || perm(acct().role, 'edit') || perm(acct().role, 'move')
        || perm(acct().role, 'del') || perm(acct().role, 'folders') || perm(acct().role, 'kho')));
    }
    function grantAllows(g, d) {
      return okGrant(g) && d.get('access', 'noi-bo') in levels(g.get('role', 'chuyen-muc'))
        && (g.get('cats', ['*']).hasAny(['*']) || g.get('cats', []).hasAny([d.cat]));
    }
    function canRead(d) {
      return isAdmin()
        || d.get('access', '') == 'cong-khai'
        || (hasAcct() && grantAllows(acct(), d))
        || (hasCode() && grantAllows(codeData(), d));
    }

    // Cấu hình, cây thư mục: ai cũng đọc (tên thư mục), chỉ người quản lý được ghi
    match /pna_settings/{id} { allow read: if true; allow write: if id == 'roles' ? isAdmin() : isManager(); }
    match /pna_tree/{id} { allow read: if true; allow write: if isManager(); }

    // Tài liệu: đọc theo mức truy cập + vai trò + danh mục
    match /pna_items/{id} {
      allow read: if canRead(resource.data);
      allow create: if (can('up') || can('kho') || can('note')) && (request.resource.data.get('access', 'noi-bo') != 'mat' || isAdmin());
      allow update: if isManager() && (request.resource.data.get('access', 'noi-bo') != 'mat' || isAdmin());
      allow delete: if can('del');
    }

    // Danh mục công khai: ai cũng thấy tên, thông tin ban hành của tài liệu (trừ Mật); không có đường link
    match /pna_catalog/{id} {
      allow read: if resource.data.get('access', 'noi-bo') != 'mat' || isAdmin();
      allow write: if isManager() && request.resource.data.get('access', 'noi-bo') != 'mat';
      allow delete: if isManager();
    }

    // Tài khoản: người dùng đọc hồ sơ của chính mình; quản trị viên quản lý;
    // cố vấn học tập cấp, sửa, xóa tài khoản loại Sinh viên
    match /pna_accounts/{em} {
      allow get: if signedIn() && (email().lower() == em || isAdmin());
      allow list, write: if isAdmin();
      // cố vấn học tập cấp tài khoản sinh viên và giao vai trò ban cán sự, BCH (lops không được tự đặt)
      allow create: if isCvht() && request.resource.data.role in ['sinh-vien', 'bcs', 'bch'] && request.resource.data.get('lops', []).size() == 0;
      allow update: if isCvht() && resource.data.role in ['sinh-vien', 'bcs', 'bch'] && request.resource.data.role in ['sinh-vien', 'bcs', 'bch']
        && request.resource.data.get('lops', []).size() == 0;
      allow delete: if isCvht() && resource.data.role in ['sinh-vien', 'bcs', 'bch'];
    }

    // Mã truy cập dùng chung
    match /pna_ma/{code} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
      match /luot/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }
    }
    match /pna_users/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ===== Thủ tục sinh viên =====
    match /pna_tt_settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pna_lop/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /pna_chuky/{em} { allow read, write: if signedIn() && me() == em; }

    // Hồ sơ sinh viên: do cố vấn học tập của lớp hoặc quản trị cấp; sinh viên đọc hồ sơ của mình
    match /pna_sv/{em} {
      allow get: if signedIn() && (me() == em || isAdmin() || me() in resource.data.cvht);
      allow list: if signedIn() && (isAdmin() || me() in resource.data.cvht);
      allow create, update: if isAdmin() || (isCvht() && me() in request.resource.data.cvht
        && request.resource.data.cvht == lopCvht(request.resource.data.lop)
        && (resource == null || me() in resource.data.cvht));
      allow delete: if isAdmin() || (isCvht() && me() in resource.data.cvht);
    }

    // Đơn: sinh viên nộp; người duyệt của bước hiện tại xử lý; lịch sử chỉ được nối thêm
    match /pna_don/{id} {
      allow read: if signedIn() && donReader(resource.data);
      allow create: if isSv()
        && request.resource.data.sv.email == me()
        && request.resource.data.sv.mssv == get(svPath()).data.mssv
        && request.resource.data.cvht == get(svPath()).data.cvht
        && request.resource.data.lop == get(svPath()).data.lop
        && request.resource.data.status == 'cho-duyet' && request.resource.data.step == 0
        && request.resource.data.steps.size() > 0 && stepOk(request.resource.data)
        && request.resource.data.history.size() == 1;
      allow update: if signedIn() && (
        // người duyệt bước hiện tại: đồng ý / yêu cầu bổ sung / không duyệt
        (donActor(resource.data) && appended(request.resource.data, resource.data) && stepOk(request.resource.data)
          && request.resource.data.status in ['cho-duyet', 'bo-sung', 'da-duyet', 'tu-choi']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'step', 'stepRole', 'history', 'updated']))
        // sinh viên: rút đơn, hoặc bổ sung và gửi lại từ bước đầu
        || (resource.data.sv.email == me() && resource.data.status in ['cho-duyet', 'bo-sung'] && appended(request.resource.data, resource.data)
          && request.resource.data.sv.email == resource.data.sv.email && request.resource.data.sv.mssv == resource.data.sv.mssv
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'step', 'stepRole', 'history', 'updated', 'data', 'lyDo', 'links', 'sv', 'svSig', 'nTep', 'hash'])
          && (request.resource.data.status == 'rut'
            || (resource.data.status == 'bo-sung' && request.resource.data.status == 'cho-duyet' && request.resource.data.step == 0 && stepOk(request.resource.data))))
        // người duyệt gắn đường link bản PDF đã ký số
        || (donReader(resource.data) && resource.data.sv.email != me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banKySo', 'updated'])));
      allow delete: if isAdmin();

      match /tep/{t} {
        allow read: if signedIn() && donReader(get(/databases/$(database)/documents/pna_don/$(id)).data);
        allow create: if signedIn() && get(/databases/$(database)/documents/pna_don/$(id)).data.sv.email == me()
          && get(/databases/$(database)/documents/pna_don/$(id)).data.status in ['cho-duyet', 'bo-sung']
          && request.resource.data.data is string && request.resource.data.data.size() < 950000;
        allow delete: if isAdmin();
      }
    }

    // ===== Hồ sơ sinh viên theo vòng đời (28/11/2026) =====
    // pna_hoso/{mã SV}: quản trị, Lãnh đạo Khoa đọc tất cả; cố vấn học tập đọc, cập nhật hồ sơ lớp mình;
    // sinh viên đọc hồ sơ của chính mình (theo mã SV trong pna_sv/{email}). Họ tên, ngày sinh, lớp, cố vấn chỉ quản trị sửa.
    function ownHoso(id) { return isSv() && get(svPath()).data.mssv == id; }
    // Ban cán sự lớp: sinh viên có chức vụ trong hồ sơ, cùng lớp
    function myHoso() { return get(/databases/$(database)/documents/pna_hoso/$(get(svPath()).data.mssv)).data; }
    // Ban quản trị lớp: tài khoản có quyền p (hs, pt, bbh, don) trong phạm vi lớp — lớp của sinh viên hoặc "lops" quản trị gán
    function myLops() { return (isSv() ? [get(svPath()).data.lop] : []).concat(acct().get('lops', [])); }
    function bqt(lop, p) { return acctOk() && perm(acct().role, p) && lop in myLops(); }
    function isBcsOf(lop) { return bqt(lop, 'bbh') || bqt(lop, 'pt'); }
    match /pna_hoso/{id} {
      allow get: if signedIn() && (isAdmin() || inNd('khoa') || me() in resource.data.get('cvht', []) || ownHoso(id) || bqt(resource.data.lop, 'hs'));
      allow list: if signedIn() && (isAdmin() || inNd('khoa') || me() in resource.data.get('cvht', []) || bqt(resource.data.lop, 'hs'));
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (me() in resource.data.get('cvht', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'sdt', 'emailLienHe', 'queQuan', 'chucVu', 'chucVuNam', 'suKien', 'drl', 'email', 'hocTap', 'updated', 'by']))
        // sinh viên tự đánh dấu tiến độ học tập theo CTĐT
        || (ownHoso(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hocTap', 'drlTu', 'updated', 'by']));
      // Phong trào: sinh viên kê khai; ban cán sự cùng lớp hoặc CVHT xác nhận
      match /hoatdong/{a} {
        allow read: if signedIn() && (isAdmin() || inNd('khoa') || me() in get(/databases/$(database)/documents/pna_hoso/$(id)).data.get('cvht', []) || ownHoso(id) || bqt(get(/databases/$(database)/documents/pna_hoso/$(id)).data.lop, 'pt') || bqt(get(/databases/$(database)/documents/pna_hoso/$(id)).data.lop, 'hs'));
        allow create: if ownHoso(id) && request.resource.data.tt == 'cho' && request.resource.data.mssv == id
          && request.resource.data.lop == get(/databases/$(database)/documents/pna_hoso/$(id)).data.lop;
        allow update: if (ownHoso(id) && resource.data.tt != 'ok' && request.resource.data.tt == 'cho' && request.resource.data.mssv == id && request.resource.data.lop == resource.data.lop)
          || ((isAdmin() || me() in resource.data.get('cvht', []) || (bqt(resource.data.lop, 'pt') && !ownHoso(id)))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tt', 'xn']));
        allow delete: if isAdmin() || me() in resource.data.get('cvht', []) || (ownHoso(id) && resource.data.tt != 'ok');
      }
      // Minh chứng rèn luyện, phong trào: thông tin tệp (minhchung) và nội dung (mcdata); sinh viên tải lên, cán bộ và BCS cùng lớp xem
      match /minhchung/{m} {
        allow read: if signedIn() && (isAdmin() || inNd('khoa') || ownHoso(id) || me() in get(/databases/$(database)/documents/pna_hoso/$(id)).data.get('cvht', []) || bqt(get(/databases/$(database)/documents/pna_hoso/$(id)).data.lop, 'pt') || bqt(get(/databases/$(database)/documents/pna_hoso/$(id)).data.lop, 'hs'));
        allow create: if ownHoso(id) && request.resource.data.by == me();
        allow delete: if ownHoso(id) || isAdmin() || me() in get(/databases/$(database)/documents/pna_hoso/$(id)).data.get('cvht', []);
      }
      match /mcdata/{m} {
        allow read: if signedIn() && (isAdmin() || inNd('khoa') || ownHoso(id) || me() in get(/databases/$(database)/documents/pna_hoso/$(id)).data.get('cvht', []) || bqt(get(/databases/$(database)/documents/pna_hoso/$(id)).data.lop, 'pt') || bqt(get(/databases/$(database)/documents/pna_hoso/$(id)).data.lop, 'hs'));
        allow create: if ownHoso(id) && request.resource.data.by == me();
        allow delete: if ownHoso(id) || isAdmin() || me() in get(/databases/$(database)/documents/pna_hoso/$(id)).data.get('cvht', []);
      }
      // Sổ tay của sinh viên: chỉ chính chủ
      match /sotay/{n} { allow read, write: if ownHoso(id); }
      // Ghi chú nội bộ của cố vấn học tập: sinh viên không xem được
      match /noibo/{n} {
        allow read, write: if signedIn() && (isAdmin()
          || me() in get(/databases/$(database)/documents/pna_hoso/$(id)).data.get('cvht', []));
      }
    }
    // Truy vấn chung kê khai phong trào (ban cán sự, CVHT xem kê khai chờ xác nhận của lớp)
    match /{path=**}/hoatdong/{a} {
      allow read: if signedIn() && (isAdmin() || inNd('khoa') || me() in resource.data.get('cvht', []) || bqt(resource.data.lop, 'pt') || (isSv() && resource.data.mssv == get(svPath()).data.mssv));
    }
    match /pna_ctdt/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // Phiếu tự đánh giá rèn luyện (bản tóm tắt để ban cán sự, CVHT tổng hợp biên bản họp lớp)
    function mySvDoc() { return get(svPath()).data; }
    match /pna_drl_phieu/{p} {
      allow read: if signedIn() && (isAdmin() || inNd('khoa') || me() in lopCvht(resource.data.lop) || bqt(resource.data.lop, 'bbh') || bqt(resource.data.lop, 'hs')
        || (isSv() && resource.data.mssv == mySvDoc().mssv));
      allow create, update: if (isSv() && request.resource.data.mssv == mySvDoc().mssv && request.resource.data.lop == mySvDoc().lop)
        || isAdmin() || me() in lopCvht(request.resource.data.lop);
      allow delete: if isAdmin();
    }
    // Biên bản họp khác của lớp, chi đoàn, chi hội: ban quản trị lớp (bbh) lập, trình; CVHT xác nhận
    match /pna_bienban/{b} {
      allow read: if signedIn() && (isAdmin() || inNd('khoa') || me() in lopCvht(resource.data.lop) || bqt(resource.data.lop, 'bbh'));
      allow create: if isAdmin() || me() in lopCvht(request.resource.data.lop) || (bqt(request.resource.data.lop, 'bbh') && request.resource.data.tt == 'nhap' && request.resource.data.by == me());
      allow update: if isAdmin() || me() in lopCvht(resource.data.lop)
        || (bqt(resource.data.lop, 'bbh') && resource.data.tt in ['nhap', 'tra-lai'] && request.resource.data.tt in ['nhap', 'trinh']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['html', 'tt', 'traLai', 'updated']));
      allow delete: if isAdmin() || me() in lopCvht(resource.data.lop) || (resource.data.by == me() && resource.data.tt == 'nhap');
    }
    // Ảnh đại diện: người dùng tự đặt; CVHT đặt cho sinh viên lớp mình; người đã đăng nhập xem
    match /pna_anh/{em} {
      allow read: if signedIn();
      allow write: if signedIn() && (me() == em || isAdmin()
        || (exists(/databases/$(database)/documents/pna_sv/$(em)) && me() in get(/databases/$(database)/documents/pna_sv/$(em)).data.cvht))
        && (request.resource == null || request.resource.data.data.size() < 120000);
    }
    // Biên bản họp lớp đánh giá rèn luyện: BCS/BCH lập, ký trình; CVHT ký, chốt
    match /pna_bbh/{b} {
      allow read: if signedIn() && (isAdmin() || inNd('khoa') || me() in lopCvht(resource.data.lop) || bqt(resource.data.lop, 'bbh'));
      allow create: if isAdmin() || me() in lopCvht(request.resource.data.lop)
        || (bqt(request.resource.data.lop, 'bbh') && request.resource.data.tt in ['nhap', 'trinh']);
      allow update: if isAdmin() || me() in lopCvht(resource.data.lop)
        || (bqt(resource.data.lop, 'bbh') && resource.data.get('tt', 'nhap') in ['nhap', 'tra-lai'] && request.resource.data.tt in ['nhap', 'trinh']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hop', 'rows', 'tt', 'lt', 'updated', 'by']));
      allow delete: if isAdmin();
    }

    // Yêu cầu đặt lại mật khẩu: quản trị hoặc CVHT gửi; GitHub Actions (quyền quản trị) áp dụng rồi xóa mật khẩu
    match /pna_yeucau_tk/{id} {
      allow create: if (isAdmin() || isCvht()) && request.resource.data.by == me()
        && request.resource.data.viec == 'dat-mat-khau' && request.resource.data.tt == 'cho'
        && request.resource.data.matKhau is string && request.resource.data.matKhau.size() >= 6
        && request.resource.data.email.matches('.*@taikhoan[.]pna');
      allow read: if isAdmin() || (signedIn() && resource.data.by == me());
      allow delete: if isAdmin();
    }

    // Nhật ký thao tác
    match /pna_activity/{id} {
      allow create: if signedIn();
      allow read, delete: if isAdmin();
    }
  }
}
